# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. Without ANTHROPIC_API_KEY set, the pipeline
# still runs end to end using a deterministic template report instead
# of a live AI-generated one.

ANTHROPIC_API_KEY=

# Zoho Desk connector — Phase 3. These belong to YOUR personal sandbox
# org only (never a real employer's Zoho tenant). Generate via
# api-console.zoho.<region> (Self Client), scope Desk.tickets.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://desk.zoho.ae
ZOHO_ORG_ID=
# Only needed if your accounts domain isn't accounts.zoho.ae:
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.ae
