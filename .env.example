# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real secrets. Without ANTHROPIC_API_KEY set, the pipeline
# still runs end to end using a deterministic template report instead
# of a live AI-generated one.

ANTHROPIC_API_KEY=

# Zoho Desk connector — Phase 3. These belong to YOUR personal sandbox
# org only (never a real employer's Zoho tenant). Generate via
# api-console.zoho.<region> (Self Client), scope Desk.tickets.READ.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://desk.zoho.ae
ZOHO_ORG_ID=
# Only needed if your accounts domain isn't accounts.zoho.ae:
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.ae

# ManageEngine ServiceDesk Plus connector — read-only. Only ever point
# this at an instance you are explicitly authorized to read from, with
# a least-privilege, read-only API credential (not a full admin key).
SDP_CLIENT_ID=
SDP_CLIENT_SECRET=
SDP_REFRESH_TOKEN=
SDP_API_DOMAIN=https://sdpondemand.manageengine.com
SDP_PORTAL_NAME=
# Only needed if your accounts domain isn't accounts.zoho.com:
SDP_ACCOUNTS_DOMAIN=https://accounts.zoho.com

# Email delivery for scheduled reports. Leave REPORT_RECIPIENT_EMAIL
# empty or pointed at your own address until you've tested with
# --dry-run and are confident in the report's accuracy — this reaches
# a real inbox with no human review in between once scheduled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REPORT_RECIPIENT_EMAIL=
